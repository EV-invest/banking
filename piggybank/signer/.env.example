# Copy to `.env` and adjust. Loaded by dotenvy in development.
# The signer is a SEPARATE process and a separate trust domain from the hub: it
# holds the chain private keys encrypted at rest and is the only process that ever
# sees the KEK.

# Topology (SIGNER_DATABASE_URL / SIGNER_GRPC_ADDR / AUTH_JWKS_GRPC_ENDPOINT)
# DEFAULTS from flake.nix; anything set here or in the environment wins. The
# signer's database is its OWN (`banking_signer`) — separate from the hub's, so
# a hub-side compromise can't even read the (already-encrypted) wallet_secrets.

# Optional overrides; defaults match the hub's issuer + service audience.
# AUTH_ISSUER=https://auth.banking.ev
# AUTH_SERVICE_AUDIENCE=banking-services

# Server TLS for the seam — REQUIRED whenever SIGNER_GRPC_ADDR is non-loopback. Point at
# PEM files; add the client-CA root to upgrade to mTLS (pin the hub's client certificate).
# SIGNER_TLS_CERT_PEM_FILE=
# SIGNER_TLS_KEY_PEM_FILE=
# SIGNER_TLS_CLIENT_CA_PEM_FILE=

# The 32-byte key-encrypting key as 64 hex chars. MUST be injected from a secrets
# store/KMS in production — NEVER commit a real KEK, and never store it next to the
# ciphertext. Fail-fast: the signer refuses to start without a valid 32-byte KEK.
# Generate a dev key:  openssl rand -hex 32
WALLET_KEK=

# --- Spend policy: the signer's OWN limits, the second gate that holds even if the hub is
# compromised (see `src/policy.rs`). Every wallet class has an always-on rule that needs no
# configuration: a deposit wallet only sweeps USDT into the treasury, the gas station only
# tops up addresses the signer itself holds, and the fee side of every signature is capped.
# What follows is what an operator may set or raise.

# Cap on a single treasury payout, in whole USDT. Always on: unset ⇒ 100 (what production
# runs), `0` refuses to boot. Size it to the hot float and raise it deliberately.
# SIGNER_MAX_TRANSFER_USDT=100
# The most USDT the treasury may pay out on one rail per sliding hour, in whole USDT — ten
# payouts at the cap above. Counted in the signer's own database; always on; `0` refuses to
# boot.
# SIGNER_MAX_TREASURY_USDT_PER_HOUR=1000
# Comma-separated destinations a treasury transfer may go to (hardened posture; off by
# default because withdrawals go to arbitrary user addresses). Any rendering the network
# accepts — EIP-55 or lowercase, TON raw or base64.
# SIGNER_DESTINATION_ALLOWLIST=
# The treasury's own USDT jetton wallet on TON: a treasury jetton transfer's
# `our_jetton_wallet` must be this address.
# SIGNER_TON_TREASURY_JETTON_WALLET=
# The token a treasury token transfer must name (the USDT cap is scaled by USDT's decimals,
# so any other token would void it). Defaults to mainnet USDT; an override must parse as an
# address of its network. TON is covered by the jetton-wallet pin above.
# SIGNER_USDT_CONTRACT_BEP20=0x55d398326f99059fF775485246999027B3197955
# SIGNER_USDT_CONTRACT_POLYGON=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# SIGNER_USDT_CONTRACT_TRC20=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Native (gas-coin) transfers FROM the treasury are refused by default — no core flow needs
# them. Opting in REQUIRES a non-empty SIGNER_DESTINATION_ALLOWLIST and at least one ceiling
# below (base units: wei / wei / SUN / nanoton); a rail without a ceiling stays refused.
# SIGNER_ALLOW_TREASURY_NATIVE=false
# SIGNER_MAX_TREASURY_NATIVE_BEP20=
# SIGNER_MAX_TREASURY_NATIVE_POLYGON=
# SIGNER_MAX_TREASURY_NATIVE_TRC20=
# SIGNER_MAX_TREASURY_NATIVE_TON=

# Fee budget — the ceiling on the gas/fee side of EVERY signature. Always on; `0` refuses
# to boot. Defaults sized so an honest hub is never refused (reasoning in `policy.rs`).
# SIGNER_MAX_GAS_LIMIT=100000
# SIGNER_MAX_GAS_PRICE_GWEI_BEP20=100
# SIGNER_MAX_GAS_PRICE_GWEI_POLYGON=5000
# SIGNER_MAX_TRON_FEE_LIMIT_SUN=100000000
# SIGNER_MAX_TON_MSG_VALUE_NANO=100000000
# SIGNER_MAX_TON_FORWARD_NANO=50000000

# Gas top-up cap — the largest native amount one gas-station drip may carry, in base units
# (wei / wei / SUN / nanoton). Always on; `0` refuses to boot.
# SIGNER_MAX_GAS_TOPUP_BEP20=50000000000000000
# SIGNER_MAX_GAS_TOPUP_POLYGON=2000000000000000000
# SIGNER_MAX_GAS_TOPUP_TRC20=50000000
# SIGNER_MAX_GAS_TOPUP_TON=200000000

# Native spend window — the most native coin one (wallet, network) may commit to per sliding
# hour (fees + native value), counted in the signer's own database before each signature.
# Base units; always on; `0` refuses to boot. Defaults reasoned in `policy.rs`.
# SIGNER_MAX_NATIVE_SPEND_PER_HOUR_BEP20=1000000000000000000
# SIGNER_MAX_NATIVE_SPEND_PER_HOUR_POLYGON=50000000000000000000
# SIGNER_MAX_NATIVE_SPEND_PER_HOUR_TRC20=2000000000
# SIGNER_MAX_NATIVE_SPEND_PER_HOUR_TON=5000000000

# Tron signing is OFF until the hub unfreezes the rail (TRC20_FROZEN in the hub's config):
# no legitimate Tron signature exists while it is frozen, so every Tron handler refuses.
# SIGNER_TRON_SIGNING_ENABLED=false

RUST_LOG=info,piggybank_signer=debug
